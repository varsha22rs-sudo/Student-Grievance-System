<%@ page import="java.util.List,com.grievance.model.Grievance,com.grievance.util.Html" %>
<%
    // Expects these variables from the including page: grievances, total, pending, progress, resolved
    int ovA = total == 0 ? 0 : (int) Math.round(pending * 100.0 / total);
    int ovB = total == 0 ? 0 : (int) Math.round((pending + progress) * 100.0 / total);
    String ovGradient = total == 0
            ? "#e8ecf3 0 100%"
            : "#e69a1a 0 " + ovA + "%, #1a68d6 " + ovA + "% " + ovB + "%, #2e9b6a " + ovB + "% 100%";
    int ovShown = 0;
%>
<section class="grid-2">
    <div class="panel">
        <h2>Status overview</h2>
        <div class="donut-wrap">
            <div class="donut" style="background: conic-gradient(<%= ovGradient %>);">
                <div class="donut-center"><strong><%= total %></strong><span>Total</span></div>
            </div>
            <ul class="legend">
                <li><i style="background:#e69a1a"></i>Awaiting action <b><%= pending %></b></li>
                <li><i style="background:#1a68d6"></i>In progress <b><%= progress %></b></li>
                <li><i style="background:#2e9b6a"></i>Resolved <b><%= resolved %></b></li>
            </ul>
        </div>
    </div>

    <div class="panel">
        <h2>Recent activity</h2>
        <% if (grievances == null || grievances.isEmpty()) { %>
            <div class="empty"><div class="big">📭</div>Nothing here yet.</div>
        <% } else { %>
        <ul class="activity">
            <% for (Grievance ovG : grievances) { if (ovShown++ >= 4) break; %>
            <li>
                <div class="bubble">📌</div>
                <div class="info">
                    <b><%= Html.esc(ovG.getTitle()) %></b>
                    <span><%= Html.esc(ovG.getDepartment()) %> · <%= Html.date(ovG.getCreatedAt()) %></span>
                </div>
                <span class="status s-<%= Html.statusClass(ovG.getStatus()) %>"><%= Html.statusLabel(ovG.getStatus()) %></span>
            </li>
            <% } %>
        </ul>
        <% } %>
    </div>
</section>
